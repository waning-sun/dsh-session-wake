{
  "name": "dsh-session-wake",
  "version": "1.0.1",
  "type": "module",
  "description": "让 DSH 会话之间互相叫醒：开机自动唤醒指定的一个或几个对话（每间可单独指定 provider / model / 思考强度）；同时给 AI 一个 session_task 工具，把一个对话里的事情丢给另一个对话去做，等它跑完再把结果取回来。不依赖 QQ、不绑定任何桥。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "README.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waning-sun/dsh-session-wake.git"
  },
  "homepage": "https://github.com/waning-sun/dsh-session-wake#readme",
  "bugs": {
    "url": "https://github.com/waning-sun/dsh-session-wake/issues"
  },
  "author": "waning-sun",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:apply": "node scripts/probe-apply-ctx.mjs",
    "test": "node scripts/check-manifest.mjs && node scripts/probe-apply-ctx.mjs && node scripts/selftest.mjs",
    "smoke": "node scripts/smoke-client.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "wake",
    "resume",
    "handoff"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "license": "MIT"
}
